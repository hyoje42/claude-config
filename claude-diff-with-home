#!/bin/bash

CLAUDE_REPO="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_SRC="$CLAUDE_REPO/home"
CLAUDE_HOME="$HOME/.claude"

# Subdirectories we fully manage. Orphans (present in dest, absent in src) are
# reported only for these — top-level dest files outside home/ are ignored.
MANAGED_DIRS=(rules skills)

changed_files=()
new_files=()
deleted_files=()

compare_file() {
    local rel_path="$1"
    local repo_file="$CLAUDE_SRC/$rel_path"
    local home_file="$CLAUDE_HOME/$rel_path"

    if [ ! -f "$home_file" ]; then
        new_files+=("$rel_path")
        return
    fi

    if ! diff -q "$repo_file" "$home_file" > /dev/null 2>&1; then
        changed_files+=("$rel_path")
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  $rel_path"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        diff -u "$home_file" "$repo_file" --label "~/.claude/$rel_path" --label "repo/home/$rel_path" 2>/dev/null | tail -n +3
        echo ""
    fi
}

echo ""
echo "Comparing repo/home → ~/.claude ..."
echo ""

# Iterate every file in home/ (top-level files + managed subdirs both covered here)
while IFS= read -r -d '' repo_file; do
    rel_path="${repo_file#$CLAUDE_SRC/}"
    compare_file "$rel_path"
done < <(find "$CLAUDE_SRC" -type f -print0 2>/dev/null)

# Orphans: files in ~/.claude/<managed>/ that are absent in home/
for d in "${MANAGED_DIRS[@]}"; do
    home_d="$CLAUDE_HOME/$d"
    src_d="$CLAUDE_SRC/$d"
    [ -d "$home_d" ] || continue
    while IFS= read -r -d '' home_file; do
        rel_in_dir="${home_file#$home_d/}"
        rel_path="$d/$rel_in_dir"
        if [ ! -f "$src_d/$rel_in_dir" ]; then
            deleted_files+=("$rel_path")
        fi
    done < <(find "$home_d" -type f -print0 2>/dev/null)
done

# Summary
echo "==========================================="
echo "  Summary"
echo "==========================================="

if [ ${#changed_files[@]} -eq 0 ] && [ ${#new_files[@]} -eq 0 ] && [ ${#deleted_files[@]} -eq 0 ]; then
    echo "  No differences found."
else
    if [ ${#changed_files[@]} -gt 0 ]; then
        echo ""
        echo "  Modified (${#changed_files[@]}):"
        for f in "${changed_files[@]}"; do
            echo "    M  $f"
        done
    fi
    if [ ${#new_files[@]} -gt 0 ]; then
        echo ""
        echo "  New in repo (${#new_files[@]}):"
        for f in "${new_files[@]}"; do
            echo "    +  $f"
        done
    fi
    if [ ${#deleted_files[@]} -gt 0 ]; then
        echo ""
        echo "  Only in ~/.claude (${#deleted_files[@]}):"
        for f in "${deleted_files[@]}"; do
            echo "    -  $f"
        done
    fi
fi

echo ""
