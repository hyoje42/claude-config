#!/bin/bash

set -euo pipefail

CLAUDE_REPO="$(cd "$(dirname "$0")" && pwd)"
CLAUDE_SRC="$CLAUDE_REPO/home"
CLAUDE_HOME="$HOME/.claude"
BACKUP_DIR="$CLAUDE_REPO/_backup"
MAX_BACKUPS=5

# Subdirectories we fully manage. Orphan files (present in dest but absent in src)
# inside these are listed and offered for deletion with confirmation.
MANAGED_DIRS=(rules skills)

mkdir -p "$CLAUDE_HOME" "$BACKUP_DIR"

list_orphans() {
    local d="$1"
    local home_d="$CLAUDE_HOME/$d"
    local src_d="$CLAUDE_SRC/$d"
    # return 0 (not bare return) so the [ -d ] failure status doesn't propagate
    # through the `n=$(... | wc -l)` pipefail and abort the script under set -e.
    [ -d "$home_d" ] || return 0
    while IFS= read -r -d '' f; do
        local rel="${f#$home_d/}"
        [ -f "$src_d/$rel" ] || echo "$f"
    done < <(find "$home_d" -type f -print0 2>/dev/null)
}

# Detect changes (rsync dry-run) and orphans before doing anything
sync_changes=$(rsync -an --itemize-changes "$CLAUDE_SRC/" "$CLAUDE_HOME/" 2>/dev/null \
    | grep -cE '^[<>ch]' || true)
orphan_count=0
for d in "${MANAGED_DIRS[@]}"; do
    n=$(list_orphans "$d" | wc -l)
    orphan_count=$((orphan_count + n))
done

if [ "$sync_changes" -eq 0 ] && [ "$orphan_count" -eq 0 ]; then
    echo "No changes."
    exit 0
fi

# Backup managed state before overwrite
timestamp=$(date +"%Y-%m-%d_%H-%M-%S")
backup_target="$BACKUP_DIR/$timestamp"
mkdir -p "$backup_target"
echo "Backing up managed parts of ~/.claude to _backup/$timestamp ..."
for d in "${MANAGED_DIRS[@]}"; do
    src="$CLAUDE_HOME/$d"
    [ -d "$src" ] || continue
    dst="$backup_target/$d"
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
done
for f in "$CLAUDE_SRC"/*; do
    [ -f "$f" ] || continue
    bn=$(basename "$f")
    [ -f "$CLAUDE_HOME/$bn" ] && cp -a "$CLAUDE_HOME/$bn" "$backup_target/"
done

# Prune old backups
find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d | sort -r \
    | tail -n +$((MAX_BACKUPS + 1)) | xargs -r rm -rf

# Sync home/ -> ~/.claude/ (add/update only; nothing in ~/.claude/ outside home/ is touched)
echo ""
echo "Syncing home/ -> ~/.claude/ ..."
rsync -av "$CLAUDE_SRC/" "$CLAUDE_HOME/"

# Orphan handling within managed subdirs (confirmed delete).
# `|| ans=""` keeps EOF on stdin (non-interactive runs) from aborting under set -e.
for d in "${MANAGED_DIRS[@]}"; do
    mapfile -t orphans < <(list_orphans "$d")
    [ ${#orphans[@]} -gt 0 ] || continue
    echo ""
    echo "Orphan files in ~/.claude/$d/ (present in dest but not in repo home/$d/):"
    for o in "${orphans[@]}"; do echo "  ${o#$CLAUDE_HOME/}"; done
    read -r -p "Delete these ${#orphans[@]} file(s)? [y/N]: " ans || ans=""
    if [[ "$ans" =~ ^[Yy]$ ]]; then
        for o in "${orphans[@]}"; do rm -v "$o"; done
        find "$CLAUDE_HOME/$d" -type d -empty -delete 2>/dev/null || true
    else
        echo "Skipped."
    fi
done

echo ""
echo "Done!"
