{
  "permissions": {
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/.git/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.gpg)",
      "Read(./**/*.ppk)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/credentials*.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/secrets*)",
      "Read(./**/*.token)",
      "Read(./**/*.tfvars)",
      "Read(./**/.npmrc)",
      "Read(./**/.git-credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.docker/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)"
    ],
    "defaultMode": "auto"
  },
  "language": "korean",
  "outputStyle": "fluent-korean-concise",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "crossSessionInbound": "accept"
}
